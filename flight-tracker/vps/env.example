# ---- Alerting: configure AT LEAST ONE channel, or you get no notifications ----

# ntfy.sh — easiest push-to-phone. Install the ntfy app, subscribe to a topic,
# then put that topic here. Pick something unguessable: topics are public.
NTFY_TOPIC=puj-fare-4d81c2ba

# Telegram — create a bot via @BotFather, then message it once to get a chat id.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Email (SMTP). For Gmail use an App Password, not your account password.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-app-password
#EMAIL_TO=you@gmail.com
#EMAIL_FROM=you@gmail.com

# Generic JSON webhook (Slack/Discord need their own formats; this posts
# {"title": ..., "body": ...}).
#WEBHOOK_URL=

# ---- Behavior ----
# Push an alert at or below this 2-passenger standard-Economy total.
TIER1_BUY_TOTAL=1600
# Quietly note new all-time lows below this (no push).
WATCH_TOTAL=1750
# Notify when a run fails (page won't load, itinerary vanished). Set 0 to silence.
NOTIFY_ON_ERROR=1
# Where the CSV lives. Defaults to ../price-log.csv next to this checkout.
#CSV_PATH=/opt/fare-tracker/price-log.csv
