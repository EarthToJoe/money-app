# Plaid credentials — get these from https://dashboard.plaid.com/developers/keys
# Copy this file to .env and paste your own values. .env is gitignored.

PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox = fake banks, free forever, no approval needed (start here)
# production = your real banks; needs the free Trial plan (up to 10 linked banks)
PLAID_ENV=sandbox

# Where the bank sends the browser back after an OAuth login. Required for the
# OAuth banks (Chase, Capital One, Bank of America, Charles Schwab, PNC, US Bank
# and friends) outside sandbox; leave it empty for sandbox or for banks that
# still take a username and password inside Plaid Link.
#   - must be https — Plaid only accepts http://localhost in Sandbox
#   - must match an entry under Plaid Dashboard → Developers → API →
#     Allowed redirect URIs *character for character*, or link-token creation
#     fails with INVALID_FIELD
#   - path must be /oauth, the route Finch uses to resume Link
# `npm run tunnel` prints the exact value to paste here (and there — a
# cloudflared quick tunnel hands out a new hostname on every run).
# PLAID_REDIRECT_URI=https://your-tunnel.trycloudflare.com/oauth

# Port the Plaid backend listens on (the web app proxies /api to it).
# Named PLAID_PORT so it can't collide with a generic PORT set for the web process.
PLAID_PORT=8787

# Optional: extra browser origins allowed to call the backend, comma-separated.
# localhost:5173 and 127.0.0.1:5173 are always allowed, so you rarely need this.
# CORS_ORIGIN=

# --- Tunnel password ---------------------------------------------------------
# `npm run tunnel` fronts your dev server with a public https URL so OAuth banks
# have somewhere to send the browser back to. While that tunnel is up, your
# machine is reachable from the internet, so Finch locks the whole dev server —
# the app's HTML and every /api route — behind HTTP Basic auth. This is the
# password it checks.
#   - leave it empty: the first `npm run tunnel` generates one, writes it here,
#     and stops without opening the tunnel so you can restart `npm run dev` and
#     let the server load it. It refuses to open an unprotected tunnel.
#   - the browser asks once per session and remembers it. ANY username works —
#     only the password is checked.
#   - change it and the dev server has to be restarted before the new value
#     counts: it is read at startup, not per request.
#   - it does nothing for plain http://localhost:5173 work. Requests from this
#     machine are never challenged, so local-only use never sees a prompt.
#   - anyone holding the tunnel URL *and* this password can read your account
#     data. Ctrl-C the tunnel once your banks are linked.
FINCH_TUNNEL_PASSWORD=

# --- Deployed Finch (finch.hughesnode.com) ------------------------------------
# The password you sign in with on your phone and any other device. Required
# for synced data to work anywhere except the machine Finch runs on. Signing
# in keeps that device signed in for a year. Pick something long; four random
# words is plenty.
# FINCH_PASSWORD=

# Optional: the key that signs sign-in cookies. Leave it unset and it is derived
# from FINCH_PASSWORD, so changing the password signs every device out.
# FINCH_SESSION_SECRET=

# Optional: the address `npm start` listens on. Set 127.0.0.1 when nginx or
# Caddy sits in front, so Finch is only reachable through it.
# FINCH_HOST=127.0.0.1
